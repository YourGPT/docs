---
import type { Props } from '@astrojs/starlight/props';
import SidebarItems from './SidebarItems.astro';
import { Menu, X, Disc, Youtube } from 'lucide-react';
import { FaDiscord, FaYoutube } from "react-icons/fa";

---

<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle mobile menu">
  <span class="menu-icon">
    <Menu size={24} />
  </span>
</button>

<div id="mobile-sidebar" class="mobile-sidebar">
  <div class="mobile-sidebar-header">
    <div class="sidebar-title">CHATBOT</div>
  </div>
  <div class="mobile-sidebar-content">
    <SidebarItems />
  </div>
  <div class="sidebar-footer">
    <a href="https://discord.gg/z8PBs5ckcd" class="sidebar-footer-item">
      <FaDiscord />
      <span>Community</span>
    </a>
    <a href="https://www.youtube.com/@YourGPTAI" class="sidebar-footer-item">
      <FaYoutube />
      <span>Youtube</span>
    </a>
  </div>
</div>

<div id="custom-sidebar" class="custom-sidebar desktop-only">
  <div class="custom-sidebar-inner">
    <div class="sidebar-section">
      <div class="section-title">CHATBOT</div>
      <SidebarItems />
    </div>
  </div>
  
  <div class="sidebar-footer">
    <a href="https://discord.com/invite/yourgpt" class="sidebar-footer-item">
      <FaDiscord />
      <span>Community</span>
    </a>
    <a href="https://www.youtube.com/@YourGPTAI" class="sidebar-footer-item">
      <FaYoutube />
      <span>Youtube</span>
    </a>
  </div>

    <style>
      .sidebar-footer {
        padding: 1rem;
        border-top: 1px solid var(--sl-color-hairline);
        position: fixed;
        bottom: 0;
        width: 16rem;
        background-color: var(--sl-color-bg-sidebar);
        z-index: 16;
      }
      .sidebar-footer-item {
        display: flex;
        align-items: center;
        padding: 0.5rem;
        color: var(--sl-color-text);
        text-decoration: none;
        border-radius: 0.375rem;
        transition: background-color 0.2s;
      }
      .sidebar-footer-item:hover {
        background-color: var(--sl-color-gray-5, var(--sl-color-gray-6));
      }
      .sidebar-footer-item span {
        margin-left: 0.5rem;
      }
    </style>
</div>


<style>
  /* Global selectors for imported content */
  :global(.sidebar-item) {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    color: var(--sl-color-text);
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 0.375rem;
    margin: 0.125rem 0;
    position: relative;
    transition: all 0.15s ease-in-out;
  }
  :global(.sidebar-item:hover) {
    background-color: var(--sl-color-gray-5, var(--sl-color-gray-6));
    color: var(--sl-color-text-accent);
  }
  :global(.sidebar-item.active) {
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    font-weight: 510;
  }
  :global(.sidebar-item.with-arrow) {
    cursor: pointer;
  }
  :global(.sidebar-item.with-arrow.expanded .arrow-icon svg) {
    transform: rotate(90deg);
  }
  :global(.sidebar-icon) {
    margin-right: 0.75rem;
    display: inline-flex;
    flex-shrink: 0;
    opacity: 0.75;
  }
  :global(.arrow-icon) {
    margin-left: auto;
    color: var(--sl-color-text-accent, var(--sl-color-gray-3));
  }
  :global(.arrow-icon svg) {
    transition: transform 0.2s ease;
  }

  /* Desktop sidebar styling */
  .custom-sidebar {
    position: fixed;
    top: var(--sl-nav-height, 4rem);
    left: 0;
    bottom: 0;
    width: 16rem;
    background-color: var(--sl-color-bg-sidebar);
    z-index: 15;
    overflow-y: auto;
    border-right: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-direction: column;
  }
  .custom-sidebar-inner {
    padding: 0.5rem 0.5rem 1rem 0.5rem;
    flex: 1;
    overflow-y: auto;
    padding-bottom: 8rem; /* Increased padding to ensure last items are fully visible */
  }
  .sidebar-section {
    margin-bottom: 1.5rem;
  }
  .section-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
    padding: 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Mobile sidebar styling */
  .mobile-sidebar {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 20rem;
    z-index: 100;
    background-color: var(--sl-color-bg-sidebar);
    box-shadow: var(--sl-shadow-md);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .mobile-sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-sidebar);
  }
  .mobile-close-button {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--sl-color-text);
    padding: 0.25rem;
    border-radius: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mobile-close-button:hover {
    background-color: var(--sl-color-gray-5, var(--sl-color-gray-6));
  }

  /* Mobile menu toggle styling */
  .mobile-menu-toggle {
    position: fixed;
    top: 0.5rem;
    right: 1rem;
    z-index: 110;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--sl-color-text);
    padding: 0.5rem;
    border-radius: 0.375rem;
    display: none; /* Hidden by default for desktop */
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }
  .mobile-menu-toggle:hover {
    background-color: var(--sl-color-backdrop-overlay);
  }

  .mobile-sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding-bottom: 8rem; /* Increased padding to ensure last items are fully visible */
  }

  @media (max-width: 50em) {
    .desktop-only {
      display: none;
    }
    .mobile-sidebar {
      display: flex;
    }
    .mobile-menu-toggle {
      display: flex;
    }
    :global(body:not([data-mobile-sidebar='open'])) .mobile-sidebar {
      transform: translateX(100%);
    }
    :global(body[data-mobile-sidebar='open']) .mobile-sidebar {
      transform: translateX(0);
    }
    .sidebar-footer {
      width: 100%;
      max-width: 20rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Helper: get unique identifier from item text
    const getItemId = (item) => item.textContent.trim().replace(/\s+/g, '_');

    // Save and load expanded state in localStorage
    const saveExpandedState = () => {
      const expanded = {};
      document.querySelectorAll('.sidebar-item.with-arrow.expanded').forEach(item => {
        expanded[getItemId(item)] = true;
      });
      localStorage.setItem('sidebarExpandedState', JSON.stringify(expanded));
    };
    
    // Clear specific item from expanded state
    const removeFromExpandedState = (itemId) => {
      try {
        const expanded = JSON.parse(localStorage.getItem('sidebarExpandedState') || '{}');
        if (expanded[itemId]) {
          delete expanded[itemId];
          localStorage.setItem('sidebarExpandedState', JSON.stringify(expanded));
        }
      } catch (e) {
        console.error('Error updating sidebar state:', e);
      }
    };
    const loadExpandedState = () => {
      try {
        return JSON.parse(localStorage.getItem('sidebarExpandedState') || '{}');
      } catch (e) {
        console.error('Error loading sidebar state:', e);
        return {};
      }
    };

    // Mobile menu toggle logic
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const closeButton = document.getElementById('mobile-close-button');
    const mobileSidebar = document.getElementById('mobile-sidebar');
    const toggleMobileMenu = () => {
      const isOpen = document.body.getAttribute('data-mobile-sidebar') === 'open';
      document.body.setAttribute('data-mobile-sidebar', isOpen ? 'closed' : 'open');
    };
    const closeMobileMenu = () => document.body.setAttribute('data-mobile-sidebar', 'closed');
    if (toggleButton) toggleButton.addEventListener('click', toggleMobileMenu);
    if (closeButton) closeButton.addEventListener('click', closeMobileMenu);
    if (mobileSidebar) {
      mobileSidebar.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMobileMenu);
      });
    }

    // Restore expanded state and mark active links
    const expandedState = loadExpandedState();
    const currentPath = window.location.pathname;
    document.querySelectorAll('.sidebar-item').forEach(item => {
      const href = item.getAttribute('href');
      if (href && currentPath.startsWith(href) && href !== '/') {
        item.classList.add('active');
        let parent = item.closest('.sub-items, .sub-items-l2');
        while (parent) {
          const parentToggle = parent.previousElementSibling;
          if (parentToggle && parentToggle.classList.contains('with-arrow')) {
            parentToggle.classList.add('expanded');
            parent.style.display = 'block';
            expandedState[getItemId(parentToggle)] = true;
          }
          parent = parent.parentElement.closest('.sub-items, .sub-items-l2');
        }
      }
    });
    document.querySelectorAll('.sidebar-item.with-arrow').forEach(item => {
      const itemId = getItemId(item);
      const subItems = item.nextElementSibling;
      if (subItems && (subItems.classList.contains('sub-items') || subItems.classList.contains('sub-items-l2'))) {
        if (expandedState[itemId]) {
          item.classList.add('expanded');
          subItems.style.display = 'block';
        } else {
          subItems.style.display = 'none';
        }
      }
      item.addEventListener('click', (event) => {
        event.preventDefault();
        const subItems = item.nextElementSibling;
        if (subItems && (subItems.classList.contains('sub-items') || subItems.classList.contains('sub-items-l2'))) {
          const isExpanded = item.classList.contains('expanded');
          const itemId = getItemId(item);
          
          if (isExpanded) {
            // Closing the folder
            item.classList.remove('expanded');
            subItems.style.display = 'none';
            removeFromExpandedState(itemId);
          } else {
            // Opening the folder
            item.classList.add('expanded');
            subItems.style.display = 'block';
            saveExpandedState();
          }
        }
      });
    });
    saveExpandedState();
  });
</script>
