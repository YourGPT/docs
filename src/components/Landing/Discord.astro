---
import { Image } from 'astro:assets';
// import yourgpt from '/assets/yourgpt-logo.svg';
import Button from '../Button.astro';
import { PiHandshake } from "react-icons/pi";

const { title, cta } = Astro.props;
---

<div class="discord">
	<h2 class="title">{title}</h2>
	<div class="cta relative	!mt-24">
		<!-- --- Light mode image --- -->
		 <div class="absolute !bottom-[36px] z-[-1] rotate-[-10deg] ">

			 <Image class="" width={100} height={100} src="/assets/houston-discord.webp" alt="" class="hide" />
		 </div>
		 <!-- --- Dark mode image --- -->
		 <!-- <div class="hidden dark:block">
			 <Image class="hidden dark:block" width={80} height={90} src="/assets/houston-discord.webp" alt="" class="hide" />

		 </div> -->
		<a href="https://discord.gg/z8PBs5ckcd" target="_blank" class=" rounded-full font-bold text-lg !text-white  py-4 px-8 lg:px-12 dark:bg-[#464bb9] dark:hover:bg-[#4857da] bg-gray-800  hover:bg-gray-900 transition-all duration-300  no-underline">{cta}</a>
	</div>
</div>

<style>
	.discord {
		margin: 0 auto;
		padding: 4rem 0;
		text-align: center;
	}

	.discord h2 {
		font-size: var(--sl-text-2xl) !important;
		font-weight: 400;
	}

	.discord .cta {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.title{
		letter-spacing: -1px;
	}
	.cta .button{
		padding: 0.6rem 1.4rem;
		border-radius: 30px;
		font-weight: 700;
		color: rgb(255, 255, 255);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		transition: all 0.5s ease;


	}
	.cta .button:hover{
		color: white;
		cursor: pointer;
		transition: all 0.5s ease;
	}

	.hide {
		margin-bottom: -13px;
		width: 4rem;
		height: 7rem;
	}
</style>
