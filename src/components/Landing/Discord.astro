---
import { Image } from 'astro:assets';
// import yourgpt from '/assets/yourgpt-logo.svg';
import Button from '../Button.astro';
import { PiHandshake } from "react-icons/pi";

const { title, cta } = Astro.props;
---

<div class="discord">
	<h2 class="title">{title}</h2>
	<div class="cta ">
		<!-- --- Light mode image --- -->
		 <div class="block dark:hidden">

			 <Image class="block dark:hidden" width={70} height={70} src="/assets/yourgpt-logo-dark.svg" alt="" class="hide" />
		 </div>
		 <!-- --- Dark mode image --- -->
		 <div class="hidden dark:block">
			 <Image class="hidden dark:block" width={70} height={70} src="/assets/yourgpt-logo-light.svg" alt="" class="hide" />

		 </div>
		<a class="button dark:bg-[#4e55f1] bg-gray-700 dark:text-white/95 ">{cta}<PiHandshake /></a>
	</div>
</div>

<style>
	.discord {
		margin: 0 auto;
		padding: 4rem 0;
		text-align: center;
	}

	.discord h2 {
		font-size: var(--sl-text-2xl) !important;
		font-weight: 400;
	}

	.discord .cta {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.title{
		letter-spacing: -1px;
	}
	.cta .button{
		padding: 0.6rem 1.4rem;
		border-radius: 30px;
		font-weight: 700;
		color: rgb(255, 255, 255);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		transition: all 0.5s ease;


	}
	.cta .button:hover{
		color: white;
		cursor: pointer;
		transition: all 0.5s ease;
	}

	.hide {
		margin-bottom: -18px;
		width: 4rem;
		height: 7rem;
	}
</style>
