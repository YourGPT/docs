---
import { Image } from 'astro:assets';
const { title, cta } = Astro.props;
---

<div class="discord-container">
  <h2 class="title">{title}</h2>
  <div class="cta-container">
    <div class="image-container">
      <Image
        src="/assets/houston-discord.webp"
        alt="A friendly robot character"
        width={100}
        height={100}
        class="astro-robot"
      />
    </div>
    <a href="https://discord.gg/z8PBs5ckcd" target="_blank" class="discord-button">{cta}</a>
  </div>
</div>

<style>
  .discord-container {
    text-align: center;
    padding: 4rem 0;
    margin: 0 auto;
  }

  .title {
    font-size: var(--sl-text-2xl);
    font-weight: 400;
    letter-spacing: -1px;
    margin-bottom: 5rem;
  }

  .cta-container {
    position: relative;
    display: inline-block;
  }

  .image-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .astro-robot {
    width: 100px;
    height: auto;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
  }

  .discord-button {
    position: relative;
    z-index: 2;
    background-color: #2c2f33;
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.125rem;
    transition: background-color 0.3s ease;
  }

  .discord-button:hover {
    background-color: #40444b;
  }

  /* Dark mode specific styles */
  :global(html.dark) .discord-button {
    background-color: #2c2f33;
    color: #ffffff !important;
  }

  :global(html.dark) .discord-button:hover {
    background-color: #40444b;
  }

  :global(html.dark) .astro-robot {
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
  }
</style>
