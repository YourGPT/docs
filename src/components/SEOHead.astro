---
// SEOHead.astro - Custom component for managing SEO metadata
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description,
  ogImage,
  canonical
} = Astro.props;

// Get the current URL for canonical link if not provided
const currentUrl = canonical || Astro.url.pathname;
const siteUrl = 'https://docs.yourgpt.ai';
const fullCanonicalUrl = `${siteUrl}${currentUrl}`;

// Generate breadcrumb data
const pathSegments = currentUrl.split('/').filter(segment => segment !== '');
const breadcrumbItems = [
  { name: 'Home', url: siteUrl }
];

// Build breadcrumb chain
let currentPath = '';
pathSegments.forEach((segment, index) => {
  currentPath += `/${segment}`;
  const isLast = index === pathSegments.length - 1;

  // Convert segment to readable name
  let name = segment.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  if (segment === 'chatbot') name = 'Chatbot';
  if (segment === 'integrations') name = 'Integrations';
  if (segment === 'changelogs') name = 'Changelogs';

  breadcrumbItems.push({
    name: isLast && title ? title : name,
    url: `${siteUrl}${currentPath}`
  });
});


const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "YourGPT",
  "url": "https://yourgpt.ai",
  "logo": "https://docs.yourgpt.ai/assets/yourgpt-logo-dark-text.svg",
  "description": "AI-first no-code platform for building custom AI Agents and chatbots",
  "sameAs": [
    "https://x.com/YourGPTAI",
    "https://www.youtube.com/@YourGPTAI"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": "https://help.yourgpt.ai"
  }
};


const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url
  }))
} : null;


---

{title && (
  <meta name="title" content={title} />
  <meta property="og:title" content={title} />
  <meta name="twitter:title" content={title} />
)}

{description && (
  <meta name="description" content={description} />
  <meta property="og:description" content={description} />
  <meta name="twitter:description" content={description} />
)}


<meta property="og:type" content="website" />
<meta property="og:site_name" content="YourGPT Documentation" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@YourGPTAI" />

{ogImage && (
  <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
  <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
)}

<link rel="canonical" href={fullCanonicalUrl} />
<meta property="og:url" content={fullCanonicalUrl} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
{breadcrumbSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
)}
