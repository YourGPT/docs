---
import { v4 as uuidv4 } from 'uuid';

interface Props {
  definition: string;
}

const { definition } = Astro.props;
const diagramId = `mermaid-diagram-${uuidv4()}`;
---
<!-- Mermaid Container -->
<div class="mermaid-container" id="mermaid-container">
  <div class="mermaid-wrapper">
    <pre class="mermaid" id={diagramId}>
      {definition}
    </pre>
  </div>
  <button class="fullscreen-toggle" aria-label="Enter fullscreen">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
    </svg>
  </button>
  <button class="exit-fullscreen" aria-label="Exit fullscreen">Exit Fullscreen</button>
</div>

<!-- Blur Overlay -->
<div class="blur-overlay"></div>

<script>
  import mermaid from 'mermaid';

  function setupMermaidContainers() {
    const containers = document.querySelectorAll('.mermaid-container');

    containers.forEach(async (container) => {
      const diagram = container.querySelector('.mermaid');
      const toggleBtn = container.querySelector('.fullscreen-toggle');
      const exitBtn = container.querySelector('.exit-fullscreen');
      const blurOverlay = document.querySelector('.blur-overlay');

      const isDarkMode = document.documentElement.classList.contains('dark');
      mermaid.initialize({ 
        startOnLoad: true, 
        theme: isDarkMode ? 'dark' : 'default',
        darkMode: isDarkMode,
        primaryColor: isDarkMode ? '#fff' : '#000',
        lineColor: isDarkMode ? '#fff' : '#000',
      });

      try {
        await mermaid.run({ nodes: [diagram] });
      } catch (error) {
        console.error('Mermaid rendering error:', error);
        diagram.innerHTML = `<p>Error rendering diagram: ${error.message}</p>`;
      }

      function toggleFullscreen() {
        container.classList.toggle('fullscreen');
        blurOverlay.classList.toggle('active');

        if (container.classList.contains('fullscreen')) {
          toggleBtn.style.display = 'none';
          exitBtn.style.display = 'block';
          document.body.style.overflow = 'hidden';
          container.style.background = 'transparent';
        } else {
          toggleBtn.style.display = 'block';
          exitBtn.style.display = 'none';
          document.body.style.overflow = '';
          container.style.background = '';
        }
      }

      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFullscreen();
      });

      exitBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFullscreen();
      });
    });
  }

  // Run setup on initial load
  setupMermaidContainers();

  // Re-run setup on Astro page changes
  document.addEventListener('astro:page-load', setupMermaidContainers);

  // Listen for dark mode changes
  document.addEventListener('astro:after-swap', setupMermaidContainers);
</script>

<style>
  /* Blur Overlay Styles */
  .blur-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    backdrop-filter: blur(5px);
    background: rgba(0, 0, 0, 0.3); /* Semi-transparent background */
    z-index: 99998; /* Just below the mermaid-container */
    pointer-events: none; /* Allow interactions with mermaid-container */
    transition: opacity 0.5s ease-in-out; /* Increased duration for smoother transition */
    opacity: 0;
  }

  .blur-overlay.active {
    display: block;
    opacity: 1;
  }

  .mermaid-container {
    position: relative;
    width: 100%;
    height: auto;
    overflow: hidden;
    transition: all 0.5s ease; /* Increased duration for smoother transition */
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 100000; /* Above the blur overlay and all other elements */
  }

  .mermaid-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid {
    width: 100%;
    height: auto;
  }

  .fullscreen-toggle {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 4px;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s ease, background-color 0.5s ease-in-out; /* Increased duration for smoother transition */
    z-index: 100001; /* Above the mermaid-container */
  }

  .mermaid-container:hover .fullscreen-toggle {
    opacity: 1;
  }

  .fullscreen-toggle:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .fullscreen-toggle svg {
    width: 24px;
    height: 24px;
    stroke: #fff;
  }

  .exit-fullscreen {
    display: none;
    position: fixed; /* Fixed to ensure it's always visible */
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 10px 20px;
    cursor: pointer;
    z-index: 100002; /* Above the blur overlay and mermaid-container */
    transition: opacity 0.5s ease; /* Increased duration for smoother transition */
  }

  .mermaid-container.fullscreen {
    position: fixed;
    top: 0;
    left: 350px;
    width: 70vw;
    height: 80vh;
    z-index: 100000; /* Ensure it's above the blur overlay and all other elements */
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    box-shadow: none;
    overflow: auto;
  }

  .mermaid-container.fullscreen .mermaid-wrapper {
    padding: 0;
    width: 100%;
    height: 100%;
  }

  .mermaid-container.fullscreen .exit-fullscreen {
    display: block;
  }

  /* Dark mode styles */
  :root.dark .mermaid-container {
    background-color: var(--sl-color-bg, #1e1e1e); /* Adjust as needed */
  }

  :root.dark .fullscreen-toggle,
  :root.dark .exit-fullscreen {
    background: rgba(255, 255, 255, 0.2);
    color: #000;
  }

  :root.dark .fullscreen-toggle:hover,
  :root.dark .exit-fullscreen:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 768px) {
    .mermaid-container.fullscreen {
      width: 100vw;
      height: 100vh;
      padding: 20px;
      border-radius: 0;
    }

    .mermaid-container.fullscreen .mermaid-wrapper {
      padding: 20px;
    }

    .exit-fullscreen {
      bottom: 10px;
      padding: 8px 16px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mermaid-container,
    .fullscreen-toggle,
    .exit-fullscreen,
    .blur-overlay {
      transition: none;
    }
  }
</style>
