---
import { v4 as uuidv4 } from 'uuid';

interface Props {
  definition: string;
}

const { definition } = Astro.props;
const diagramId = `mermaid-diagram-${uuidv4()}`;
---

<div class="mermaid-container">
  <div class="mermaid-wrapper">
    <pre class="mermaid" id={diagramId}>
      {definition}
    </pre>
  </div>
  <button class="fullscreen-toggle" aria-label="Enter fullscreen">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
    </svg>
  </button>
  <button class="exit-fullscreen" aria-label="Exit fullscreen">
    Exit Fullscreen
  </button>
</div>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({ startOnLoad: true, theme: 'default' });

  function setupMermaidContainers() {
    const containers = document.querySelectorAll('.mermaid-container');
    
    containers.forEach(async (container) => {
      const diagram = container.querySelector('.mermaid');
      const toggleBtn = container.querySelector('.fullscreen-toggle');
      const exitBtn = container.querySelector('.exit-fullscreen');

      try {
        await mermaid.run({ nodes: [diagram] });
      } catch (error) {
        console.error('Mermaid rendering error:', error);
        diagram.innerHTML = `<p>Error rendering diagram: ${error.message}</p>`;
      }

      function toggleFullscreen() {
        container.classList.toggle('fullscreen');
        if (container.classList.contains('fullscreen')) {
          toggleBtn.setAttribute('aria-label', 'Exit fullscreen');
          document.body.style.overflow = 'hidden';
        } else {
          toggleBtn.setAttribute('aria-label', 'Enter fullscreen');
          document.body.style.overflow = '';
        }
      }

      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFullscreen();
      });

      exitBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFullscreen();
      });

      container.addEventListener('click', (e) => {
        if (container.classList.contains('fullscreen') && e.target === container) {
          toggleFullscreen();
        }
      });
    });
  }

  // Run setup on initial load
  setupMermaidContainers();

  // Re-run setup on Astro page changes
  document.addEventListener('astro:page-load', setupMermaidContainers);
</script>

<style>
  .mermaid-container {
    position: relative;
    width: 100%;
    height: 200px; /* Adjust this to control the default size */
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .mermaid-wrapper {
    width: 100%;
    height: 100%;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid {
    max-width: 100%;
    max-height: 100%;
  }

  .fullscreen-toggle {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10000;
  }

  .fullscreen-toggle svg {
    width: 24px;
    height: 24px;
  }

  .exit-fullscreen {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border: none;
    border-radius: 20px;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 16px;
    display: none;
    z-index: 10001;
  }

  .mermaid-container:hover .fullscreen-toggle {
    opacity: 1;
  }

  .mermaid-container.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.9);
    cursor: default;
  }

  .mermaid-container.fullscreen .mermaid-wrapper {
    padding: 40px;
    box-sizing: border-box;
  }

  .mermaid-container.fullscreen .mermaid {
    max-width: 100%;
    max-height: calc(100vh - 80px);
    width: auto;
    height: auto;
  }

  .mermaid-container.fullscreen .fullscreen-toggle {
    opacity: 1;
  }

  .mermaid-container.fullscreen .exit-fullscreen {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .mermaid-container,
    .fullscreen-toggle,
    .exit-fullscreen {
      transition: none;
    }
  }
</style>