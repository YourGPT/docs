---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header-container">
  <div class="header">
    <div class="left-section">
      <div class="title-wrapper">
        <SiteTitle />
      </div>
    </div>
    <div class="center-section print:hidden">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="right-section print:hidden">
      <div class="nav-links">
        <!-- <a href="https://discord.gg/z8PBs5ckcd" class="nav-link" target="_blank" rel="noopener">Community</a> -->
        <a href="https://help.yourgpt.ai" class="nav-link" target="_blank" rel="noopener">Help Center</a>
      </div>
      <a href="https://app.yourgpt.ai/" class="sign-in-button" target="_blank" rel="noopener">
        <span>Sign up</span>
        <!-- <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg> -->
      </a>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  .header-container {
    width: 100%;
    background-color: var(--sl-color-bg, rgba(255, 255, 255, 0.95));
    border-bottom: 1px solid var(--sl-color-hairline, #eaeaea);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  :global([data-theme="dark"]) .header-container {
    background-color: var(--sl-color-bg-nav, rgba(31, 41, 55, 0.95));
    border-bottom: 1px solid var(--sl-color-hairline, #303035);
  }

  .header {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr minmax(250px, 500px) 1fr;
    justify-content: space-between;
    align-items: center;
    height: 55px;
    position: relative;
  }
  
  :global(body) {
    padding-top: 50px;
  }

  .left-section {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0;
    min-width: 0;
    flex-shrink: 0;
  }

  /* Remove any padding from SiteTitle */
  :global(.site-title) {
    padding: 0 !important;
    margin-right: 1rem;
    justify-content: flex-start !important;
  }
  
  /* Make logo smaller */
  :global(.site-title img) {
    width: 55px !important;
    height: auto !important;
  }
  
  /* Fix alignment for SiteTitle */
  :global(.site-title a) {
    justify-content: flex-start !important;
  }

  /* Center the search component */
  .center-section {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Make the search component wider */
  :global(.search) {
    width: 100%;
  }

  :global(.search-input-container) {
    width: 100% !important;
  }

  :global(.search-input) {
    width: 100% !important;
    border-radius: 100px !important;
    font-size: 0.875rem !important;
    padding: 0.4rem 0.875rem !important;
    background-color: var(--sl-color-bg-inline-code, rgba(0, 0, 0, 0.05)) !important;
    color: var(--sl-color-text) !important;
    border: 1px solid transparent !important;
    transition: all 0.2s ease !important;
  }

  :global([data-theme="dark"]) :global(.search-input) {
    background-color: var(--sl-color-black-alpha-10, rgba(255, 255, 255, 0.05)) !important;
  }

  :global(.search-input:focus) {
    border-color: var(--sl-color-text-accent) !important;
    box-shadow: 0 0 0 2px rgba(var(--sl-color-accent-rgb), 0.25) !important;
  }

  .right-section {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: flex-end;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin-right: 0.5rem;
  }

  .nav-link {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  :global([data-theme="dark"]) .nav-link {
    color: var(--sl-color-gray-2);
  }

  .nav-link:hover {
    color: var(--sl-color-text);
    background-color: var(--sl-color-bg-hover);
  }

  :global([data-theme="dark"]) .nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-bg-hover);
  }

  .sign-in-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.35rem 0.875rem;
    border-radius: 100px;
    background-color: var(--sl-color-text-accent, #404040);
    color: white;
    font-weight: 600;
    font-size: 0.8125rem;
    transition: all 0.2s ease;
    white-space: nowrap;
    order: -1; /* This puts the button first */
  }

  :global([data-theme="dark"]) .sign-in-button {
    background-color: var(--sl-color-accent-high, #f5f5f5);
    color: var(--sl-color-black, #1a1a1a);
  }

  .sign-in-button:hover {
    background-color: var(--sl-color-text-accent-high, #333333);
    transform: translateY(-1px);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="dark"]) .sign-in-button:hover {
    background-color: white;
    box-shadow: 0 2px 5px rgba(255, 255, 255, 0.1);
  }

  .arrow-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Style theme toggle and language selector */
  :global(.theme-select) {
    margin: 0 !important;
  }

  :global(.language-select) {
    margin: 0 !important;
  }

  @media (max-width: 1100px) {
    .header {
      grid-template-columns: auto 1fr auto;
    }

    .center-section {
      padding: 0 1rem;
    }
  }

  @media (max-width: 950px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 0 1rem;
      grid-template-columns: auto auto;
    }

    .center-section {
      display: none;
    }
  }

  @media (max-width: 500px) {
    :global(.language-select) {
      display: none !important;
    }
  }
</style>
