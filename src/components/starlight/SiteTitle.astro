---
import { Image } from "astro:assets";
const main = "#";
---

<a class="site-title" href="/" aria-label="Go to homepage">
  <Image class="block dark:hidden logo-image" width={100} height={100} src="/assets/yourgpt-logo-dark-text.svg" alt="YourGPT logo (light mode)" />
  <Image class="hidden dark:block logo-image" width={100} height={100} src="/assets/yourgpt-logo-light-text.svg" alt="YourGPT logo (dark mode)" />
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 !important;
    margin: 0 !important;
    position: relative;
    left: 0;
    width: auto;
  }

  /* Logo image styling */
  .logo-image {
    width: 90px !important;
    height: auto !important;
    object-fit: contain !important;
    transform: none !important;
    transition: opacity 0.2s ease !important;
  }

  /* On focus styling */
  .site-title:focus-visible {
    outline: 0;
  }

  .site-title:focus-visible > :global(*) {
    outline: auto;
    outline-offset: 0.33rem;
    border-radius: 1px;
  }

  /* Subtle hover effect */
  .site-title:hover .logo-image {
    opacity: 0.9;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .logo-image {
      width: 80px !important;
    }
  }

  @media (max-width: 480px) {
    .logo-image {
      width: 70px !important;
    }
  }
</style>
