---
interface Props {
  title: string;
  description?: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="custom-link-card">
  <div class="custom-link-card-content">
    <div class="custom-link-card-header">
      <slot name="icon">
        <!-- No icon by default -->
      </slot>
      <div class="custom-link-card-title">{title}</div>
    </div>
    {description && <div class="custom-link-card-description">{description}</div>}
    <div class="custom-link-card-list">
      <slot name="list">
        <!-- Optional list content -->
      </slot>
    </div>
  </div>
  <div class="custom-link-card-arrow">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18l6-6-6-6"></path>
    </svg>
  </div>
</a>

<style>
  .custom-link-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: #ffffff;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    margin: 1rem 0;
    width: 100%;
    box-shadow: var(--sl-shadow-sm);
  }

  /* Dark mode styling */
  :global([data-theme="dark"]) .custom-link-card {
    background-color: var(--sl-color-black);
    border-color: var(--sl-color-gray-5);
  }

  /* Hover effects */
  .custom-link-card:hover {
    border-color: var(--sl-color-gray-3);
    box-shadow: var(--sl-shadow-md);
    background-color: #f9fafb;
  }

  :global([data-theme="dark"]) .custom-link-card:hover {
    background-color: #1f2937;
  }

  .custom-link-card-content {
    flex: 1;
  }

  .custom-link-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .custom-link-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #374151;
    margin: 0;
    line-height: 1.5;
  }

  :global([data-theme="dark"]) .custom-link-card-title {
    color: #f9fafb;
  }

  /* Icon styling */
  .custom-link-card-header :global(svg) {
    width: 24px;
    height: 24px;
    color: #4f46e5;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: text-top;
    margin-top: 2px;
  }

  :global([data-theme="dark"]) .custom-link-card-header :global(svg) {
    color: #818cf8;
  }

  .custom-link-card-description {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.5;
  }

  :global([data-theme="dark"]) .custom-link-card-description {
    color: #9ca3af;
  }

  /* List styling */
  .custom-link-card-list {
    margin-top: 0.75rem;
  }

  .custom-link-card-list :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.5;
  }

  :global([data-theme="dark"]) .custom-link-card-list :global(ul) {
    color: #9ca3af;
  }

  .custom-link-card-list :global(li) {
    margin-bottom: 0.25rem;
  }

  .custom-link-card-list :global(li:last-child) {
    margin-bottom: 0;
  }

  .custom-link-card-arrow {
    color: #9ca3af;
    margin-left: 1rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-link-card-arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .custom-link-card:hover .custom-link-card-arrow {
    color: #3b82f6;
  }

  :global([data-theme="dark"]) .custom-link-card:hover .custom-link-card-arrow {
    color: #60a5fa;
  }
</style>
