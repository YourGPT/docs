---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';

// Check if we're on pages where footer should be hidden
const currentUrl = Astro.url.pathname;
const isChangelogsPage = currentUrl === '/changelogs' || currentUrl === '/changelogs/';
const isHomePage = currentUrl === '/' || currentUrl === '';
const shouldHideFooter = isChangelogsPage || isHomePage;
---

{!shouldHideFooter && <Default {...Astro.props} />}
